# Credenziali progetto firebase
# Reperibili in: Console Firebase -> Impostazioni progetto -> Le tue app -> Configurazione SDK
# I valori qui sotto sono segnaposto di esempio, non credenziali reali.

VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdefgh
VITE_FIREBASE_AUTH_DOMAIN=nome-progetto-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nome-progetto-id
VITE_FIREBASE_STORAGE_BUCKET=nome-progetto-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:a1b2c3d4e5f6g7h8